<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>ci.selective</groupId>
  <artifactId>selective-java-junit</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>
  <name>selective-java-junit</name>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>
  <modules>
    <module>spi</module>
    <module>core</module>
    <module>suite</module>
  </modules>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <junit.version>5.13.4</junit.version>
    <surefire.version>3.2.5</surefire.version>
    <gson.version>2.11.0</gson.version>
    <transport.version>0.2.0</transport.version>
    <transport.sha256.Darwin-aarch64>7dcaec969378a181a62749673b9c0b658be17bf16a8880f5effbd8e03a6c4a17</transport.sha256.Darwin-aarch64>
    <transport.sha256.Darwin-x86_64>ccb9f795086d5584ff605cff8aefc534a82cde3154a3231f7f9396cde27bf7d4</transport.sha256.Darwin-x86_64>
    <transport.sha256.Linux-aarch64>cf54fbf596b8a708fbc64e031f98737f076b8c32c371a4506c8141c49bca84be</transport.sha256.Linux-aarch64>
    <transport.sha256.Linux-x86_64>87b2d6847ed0efa44c73ec16526b85134bf6f2e3759d99f925682eaf1b27d937</transport.sha256.Linux-x86_64>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>junit</groupId>
        <artifactId>junit</artifactId>
        <version>4.13.2</version>
      </dependency>
      <dependency>
        <groupId>com.google.code.gson</groupId>
        <artifactId>gson</artifactId>
        <version>${gson.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.maven.surefire</groupId>
        <artifactId>surefire-api</artifactId>
        <version>${surefire.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <release>${maven.compiler.release}</release>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${surefire.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
  <profiles>
    <profile>
      <id>no-class-template</id>
      <activation>
        <property>
          <name>selective.noClassTemplate</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
              <testExcludes>
                <testExclude>**/ClassTemplateHooks.java</testExclude>
              </testExcludes>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
